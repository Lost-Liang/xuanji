generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agent_bindings {
  id               String   @id
  plugin_id        String?
  agent_id         String
  harness          String   @default("claude")
  skill_id         String?
  prompt_content   String   @default("")
  triggers         Json?
  model            String?
  reasoning_effort String?
  created_at       DateTime @default(now())
}

model books {
  id             String   @id
  isbn           String   @unique
  title          String
  author         String
  publisher      String
  category       String
  stock_quantity Int      @default(0)
  created_at     DateTime @default(now())
}

model conversation_events {
  id              String           @id
  execution_id    String?
  session_id      String?
  turn_index      Int?
  event_type      String
  role            String?
  payload         Json
  created_at      DateTime         @default(now())
  task_executions task_executions? @relation(fields: [execution_id], references: [execution_id])

  @@index([execution_id])
  @@index([session_id])
}

model decisions {
  id                Int              @id @default(autoincrement())
  execution_id      String?
  task_id           String?
  phase_instance_id String?
  phase             String
  decision          String
  confidence        Int
  severity          String           @default("green")
  raw               String?
  created_at        DateTime         @default(now())
  task_executions   task_executions? @relation(fields: [execution_id], references: [execution_id])
  phase_instances   phase_instances? @relation(fields: [phase_instance_id], references: [id])
  tasks             tasks?           @relation(fields: [task_id], references: [id])
}

model epics {
  id                  String         @id
  requirement_id      String?
  title               String
  description         String?
  module              String?
  status              String         @default("pending")
  created_at          DateTime       @default(now())
  acceptance_criteria String?
  priority            String?
  requirements        requirements?  @relation(fields: [requirement_id], references: [id])
  features            features[]
  tasks               tasks[]
  user_stories        user_stories[]
}

model execution_events {
  id              Int             @id @default(autoincrement())
  execution_id    String
  event_type      String
  from_status     String?
  to_status       String?
  message         String?
  details         String?         // JSON string containing error details (node, visits, errorType)
  created_at      DateTime        @default(now())
  task_executions task_executions @relation(fields: [execution_id], references: [execution_id])
}

model features {
  id                  String         @id
  epic_id             String?
  title               String
  description         String?
  status              String         @default("pending")
  created_at          DateTime       @default(now())
  acceptance_criteria String?
  module              String?
  priority            String?
  epics               epics?         @relation(fields: [epic_id], references: [id], onDelete: Cascade)
  user_stories        user_stories[]
}

model graph_definitions {
  id              String   @id
  name            String
  plugin_id       String?
  description     String?
  definition_json Json
  created_at      DateTime @default(now())
  updated_at      DateTime
}

model inbox_questions {
  id              String           @id
  execution_id    String?
  session_id      String?
  body            String
  choices         Json?
  answer          String?
  status          String           @default("pending")
  created_at      DateTime         @default(now())
  answered_at     DateTime?
  processId       String?
  timeoutMs       Int?
  waitingSince    DateTime?
  task_executions task_executions? @relation(fields: [execution_id], references: [execution_id])
}

model interventions {
  id              Int              @id @default(autoincrement())
  execution_id    String?
  task_id         String?
  phase_id        String?
  type            String
  message         String
  suggested_agent String?
  status          String           @default("pending")
  created_at      DateTime         @default(now())
  task_executions task_executions? @relation(fields: [execution_id], references: [execution_id])
  tasks           tasks?           @relation(fields: [task_id], references: [id])
}

model phase_instances {
  id                    String          @id
  execution_id          String
  phase_id              String
  task_id               String?
  requirement_id        String?
  attempt               Int             @default(1)
  status                String          @default("pending")
  session_id            String?
  agent_used            String?
  result_summary        String?
  result_content        String?
  result_payload        Json?
  result_schema_version String?
  error_message         String?
  started_at            DateTime?
  completed_at          DateTime?
  created_at            DateTime        @default(now())
  decisions             decisions[]
  task_executions       task_executions @relation(fields: [execution_id], references: [execution_id])
  requirements          requirements?   @relation(fields: [requirement_id], references: [id])
  tasks                 tasks?          @relation(fields: [task_id], references: [id])
  phase_outputs         phase_outputs[]

  @@index([execution_id])
  @@index([task_id])
}

model phase_outputs {
  id                Int             @id @default(autoincrement())
  phase_instance_id String
  key               String
  value             String?
  created_at        DateTime        @default(now())
  phase_instances   phase_instances @relation(fields: [phase_instance_id], references: [id])
}

model projects {
  id          String   @id
  name        String
  path        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model requirements {
  id                   String            @id
  title                String
  description          String?
  status               String            @default("draft")
  target_project_id    String
  target_repo_path     String
  auto_execute         Boolean           @default(false)
  max_concurrent_tasks Int               @default(1)
  created_at           DateTime          @default(now())
  workflow_id          String?           @default("requirement-decomposition")
  business_goal        String?
  spec_doc             String?
  epics                epics[]
  phase_instances      phase_instances[]
  task_executions      task_executions[]
  task_logs            task_logs[]
}

model scheduling_events {
  id                  Int      @id @default(autoincrement())
  actor               String
  action              String
  target_execution_id String?
  target_task_id      String?
  decision            String
  reason              String?
  created_at          DateTime @default(now())
}

model task_executions {
  execution_id        String                @id
  subject_type        String
  subject_id          String
  task_id             String?
  requirement_id      String?
  target_project_id   String
  target_repo_path    String
  stage               String                @default("planning")
  status              String                @default("pending")
  control_status      String                @default("idle")
  provider            String?
  session_id          String?
  final_output        String?
  worker_id           String?
  lease_token         String?
  fencing_token       Int                   @default(0)
  lease_expires_at    DateTime?
  heartbeat_at        DateTime?
  rate_limit_count    Int                   @default(0)
  max_duration_min    Int                   @default(240)
  stall_timeout_min   Int                   @default(10)
  error_message       String?
  created_at          DateTime              @default(now())
  started_at          DateTime?
  paused_at           DateTime?
  completed_at        DateTime?
  retry_at            DateTime?
  graph_definition_id String?
  thread_id           String?
  conversation_events conversation_events[]
  decisions           decisions[]
  execution_events    execution_events[]
  inbox_questions     inbox_questions[]
  interventions       interventions[]
  phase_instances     phase_instances[]
  requirements        requirements?         @relation(fields: [requirement_id], references: [id])
  tasks               tasks?                @relation(fields: [task_id], references: [id])
  task_logs           task_logs[]

  @@index([lease_expires_at])
  @@index([status])
  @@index([subject_type, subject_id])
}

model task_logs {
  id              Int              @id @default(autoincrement())
  execution_id    String?
  task_id         String?
  requirement_id  String?
  phase           String?
  message         String
  created_at      DateTime         @default(now())
  task_executions task_executions? @relation(fields: [execution_id], references: [execution_id])
  requirements    requirements?    @relation(fields: [requirement_id], references: [id])
  tasks           tasks?           @relation(fields: [task_id], references: [id])
}

model tasks {
  id                  String            @id
  user_story_id       String?
  epic_id             String?
  parent_task_id      String?
  title               String
  description         String?
  acceptance_criteria String?
  tech_constraints    Json?
  story_context       String?
  status              String            @default("pending")
  target_project_id   String
  target_repo_path    String
  sequence            Int               @default(0)
  version             Int               @default(0)
  retry_at            DateTime?
  created_at          DateTime          @default(now())
  started_at          DateTime?
  completed_at        DateTime?
  estimated_hours     Float?
  task_type           String?
  acceptance_steps    Json?
  priority            String?
  decisions           decisions[]
  interventions       interventions[]
  phase_instances     phase_instances[]
  task_executions     task_executions[]
  task_logs           task_logs[]
  epics               epics?            @relation(fields: [epic_id], references: [id])
  tasks               tasks?            @relation("tasksTotasks", fields: [parent_task_id], references: [id])
  other_tasks         tasks[]           @relation("tasksTotasks")
  user_stories        user_stories?     @relation(fields: [user_story_id], references: [id])
}

model user_stories {
  id              String    @id
  epic_id         String?
  feature_id      String?
  title           String
  as_a            String?
  i_want          String?
  so_that         String?
  acceptance_text String?
  priority        String    @default("P2")
  status          String    @default("pending")
  created_at      DateTime  @default(now())
  module          String?
  tasks           tasks[]
  epics           epics?    @relation(fields: [epic_id], references: [id])
  features        features? @relation(fields: [feature_id], references: [id])
}
