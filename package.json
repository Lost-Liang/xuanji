{
  "name": "xuanji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @xuanji/core db:generate",
    "db:migrate": "pnpm --filter @xuanji/core db:migrate",
    "db:push": "pnpm --filter @xuanji/core db:push"
  },
  "engines": { "node": ">=18" },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "vue-demi"
    ]
  }
}